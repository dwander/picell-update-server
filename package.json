{
  "name": "picell-update-server",
  "version": "2.0.0",
  "description": "PiCell One 업데이트 배포 서버 — R2 아티팩트 저장소 + 릴리즈/체인지로그 관리 콘솔",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev-local.sh",
    "build": "node scripts/ensure-native-deps.mjs && vite build && tsc",
    "build:api": "tsc",
    "build:web": "vite build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./web/tsconfig.json",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:api": "tsx watch --env-file=.env src/index.ts",
    "dev:web": "vite"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/lib-storage": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@hono/node-server": "^1.19.13",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.34"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.2",
    "drizzle-kit": "^0.31.10",
    "lucide-svelte": "^1.0.1",
    "marked": "^18.0.7",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^6.0.2",
    "vite": "^8.2.0"
  }
}
