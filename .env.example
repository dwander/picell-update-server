# ─── 서버 ────────────────────────────────────────────────────────────────────
PORT=3000
# SQLite 파일 경로. Railway에서는 **볼륨 마운트 경로**를 지정할 것
# (예: /data/update.db). 볼륨 없이 컨테이너 파일시스템에 두면 재배포마다 통계가
# 사라진다. 릴리즈 메타도 여기 있으므로 볼륨은 사실상 필수.
DB_PATH=data.db

# 관리 콘솔(/admin) 로그인 비밀번호. 미설정 시 콘솔 전체가 비활성화된다.
# (구 STATS_PASSWORD도 폴백으로 인식한다.)
ADMIN_PASSWORD=

# 로컬 http 개발에서 세션 쿠키가 안 붙으면 0으로. 운영(https)은 건드리지 말 것.
# SECURE_COOKIE=1

# ─── R2 오브젝트 스토리지 (S3 호환) ──────────────────────────────────────────
# 업데이트 바이너리 저장소. picell-works-cloud와 **다른 버킷**을 쓴다
# (그쪽은 photo-works, 여기는 picell-one) — 서로의 GC/정리 도구가 간섭하지 않는다.
#
#   STORAGE_ENDPOINT = https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
#   STORAGE_BUCKET   = picell-one
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=picell-one

# 공개 커스텀 도메인을 붙였다면 여기에. 설정하면 다운로드가 이 도메인으로
# 302되고(캐시 가능·무제한 유효), 비우면 서버가 매번 presigned GET을 발급한다.
STORAGE_PUBLIC_BASE_URL=

# 로컬 개발이 운영 버킷을 쓸 때 키 충돌을 막는 접두어. 운영에서는 비워 둔다.
# STORAGE_KEY_PREFIX=dev/

# presigned URL 만료(초). 대용량 업로드가 자주 끊기면 PUT 쪽을 늘린다.
# STORAGE_PUT_TTL_SEC=3600
# STORAGE_GET_TTL_SEC=600

# ─── GitHub 임포트 (일회성 이관 도구) ────────────────────────────────────────
# 과거 릴리즈를 R2로 옮길 때만 쓴다. 이관이 끝나면 지워도 서비스는 정상 동작한다.
GITHUB_OWNER=dwander
GITHUB_REPO=picell-releases
# 비공개 레포이거나 시간당 60회 제한이 걸리면 설정.
GITHUB_TOKEN=
